{
  "$comment": "TECH_DESIGN 13.3. 템플릿의 {{name}}은 params, models, inputs 또는 filename_prefix여야 한다. 브릿지가 시작할 때 검증하고 comfy_workflows에 동기화한다.",
  "image_generation_v1": {
    "version": "1.0",
    "type": "image",
    "stage": "mvp",
    "enabled": true,
    "file": "image_generation_v1.json",
    "params": {
      "prompt": {
        "type": "str",
        "required": true
      },
      "negative_prompt": {
        "type": "str",
        "default": ""
      },
      "width": {
        "type": "int",
        "default": 1024,
        "min": 512,
        "max": 2048,
        "multiple_of": 8
      },
      "height": {
        "type": "int",
        "default": 1024,
        "min": 512,
        "max": 2048,
        "multiple_of": 8
      },
      "steps": {
        "type": "int",
        "default": 30,
        "min": 1,
        "max": 80
      },
      "cfg": {
        "type": "float",
        "default": 7.0,
        "min": 1,
        "max": 20
      },
      "sampler": {
        "type": "str",
        "default": "euler",
        "enum": [
          "euler",
          "euler_ancestral",
          "dpmpp_2m",
          "dpmpp_2m_sde",
          "dpmpp_sde"
        ]
      },
      "scheduler": {
        "type": "str",
        "default": "normal",
        "enum": [
          "normal",
          "karras",
          "exponential",
          "sgm_uniform"
        ]
      },
      "seed": {
        "type": "int",
        "default": -1,
        "min": -1,
        "max": 4294967295
      },
      "batch_size": {
        "type": "int",
        "default": 1,
        "min": 1,
        "max": 4
      }
    },
    "models": {
      "checkpoint": {
        "node": "CheckpointLoaderSimple",
        "input": "ckpt_name"
      }
    },
    "inputs": {},
    "output": {
      "asset_type": "image",
      "mime": [
        "image/png"
      ],
      "min_bytes": 10240,
      "check_dimensions": true
    },
    "oom_fallback": {
      "allow_downscale": true,
      "min_pixels": 786432
    }
  },
