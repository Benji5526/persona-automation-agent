# Supabase (Project Settings → API). service_role 키는 절대 커밋/공개 금지
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=media

# n8n → 브릿지 호출 시 X-Bridge-Token 헤더로 보낼 값 (python -c "import secrets;print(secrets.token_urlsafe(32))")
BRIDGE_TOKEN=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000

# 로컬 ComfyUI (API 모드)
COMFY_URL=http://127.0.0.1:8188
DEFAULT_CHECKPOINT=
JOB_TIMEOUT_SEC=900
POLL_INTERVAL_SEC=1.0
# 일시적 오류 재시도 간격(초). 60 → 120 → 240 ... (최대 횟수는 media_queue.max_attempts)
RETRY_BASE_DELAY_SEC=60

# (선택) 작업 완료/실패 시 브릿지가 호출할 n8n Webhook URL
N8N_CALLBACK_URL=
N8N_CALLBACK_TOKEN=
