# =============================================================================
# Python 브릿지 설정 (TECH_DESIGN 16.5). 이 파일을 .env로 복사해서 채운다. .env는 git에 올리지 않는다.
# =============================================================================

# Supabase (Project Settings → API Keys)
SUPABASE_URL=https://<project-ref>.supabase.co

# -----------------------------------------------------------------------------
# Worker 인증 (TECH_DESIGN 56.5): secret_key | worker_jwt
#   secret_key  로컬 Phase 0. 브릿지 전용 secret key를 따로 만든다 (n8n과 다른 키, 15.6)
#   worker_jwt  Cloud와 수렴하는 경로. Worker JWT + 공개 anon 키만 쓴다
# -----------------------------------------------------------------------------
WORKER_AUTH=secret_key

# WORKER_AUTH=secret_key 일 때만 채운다
SUPABASE_SECRET_KEY=

# WORKER_AUTH=worker_jwt 일 때만 채운다 (scripts/mint_worker_token.py로 발급, 수명 24시간 이하)
#   ⚠ 이 모드에서는 SUPABASE_SECRET_KEY·JWT 서명 키·SNS 토큰이 환경에 있으면 브릿지가 기동을 거부한다 (56.6)
WORKER_JWT=
SUPABASE_ANON_KEY=

# n8n → 브릿지 X-Bridge-Token. 32자 이상. 교체할 때는 "새토큰,이전토큰"으로 두 개를 잠시 함께 둔다
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_TOKENS=

# 브릿지가 작업 완료·실패를 알릴 n8n Webhook (WF-004)
N8N_CALLBACK_URL=
N8N_CALLBACK_TOKEN=

# 로컬 ComfyUI (127.0.0.1만 허용. 외부에 열지 않는다, 15.7)
COMFY_URL=http://127.0.0.1:8188

# Worker 식별자 (worker_status, automation_jobs.claimed_by). GPU 모델을 이름에 넣지 않는다 (56.2)
WORKER_ID=python:local-1

# 이 Worker가 **보고하는** Execution Target과 GPU Provider.
# 선점 가능 여부는 DB가 정한다 (Job의 execution_target + 인증된 신원) — 여기서 고르는 것이 아니다.
WORKER_TARGET=local
WORKER_PROVIDER=local

# Worker Pull (56.3): 기본 실행 경로. 놀고 있을 때 DB에서 generation Job을 가져간다
PULL_JOBS=true
PULL_INTERVAL_SEC=5

# 시간 (초)
JOB_TIMEOUT_SEC=900
HEARTBEAT_SEC=30
STATUS_REPORT_SEC=30

# 브릿지 주소. Cloudflare Tunnel이 이 주소로 연결한다
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000
LOG_LEVEL=INFO
