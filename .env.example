# =============================================================================
# Python 브릿지 설정 (TECH_DESIGN 16.5). 이 파일을 .env로 복사해서 채운다. .env는 git에 올리지 않는다.
# =============================================================================

# Supabase (Project Settings → API Keys). 브릿지 전용 secret key를 따로 만든다 (n8n과 다른 키, 15.6)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# n8n → 브릿지 X-Bridge-Token. 32자 이상. 교체할 때는 "새토큰,이전토큰"으로 두 개를 잠시 함께 둔다
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_TOKENS=

# 브릿지가 작업 완료·실패를 알릴 n8n Webhook (WF-004)
N8N_CALLBACK_URL=
N8N_CALLBACK_TOKEN=

# 로컬 ComfyUI (127.0.0.1만 허용. 외부에 열지 않는다, 15.7)
COMFY_URL=http://127.0.0.1:8188

# Worker 식별자 (worker_status, automation_jobs.claimed_by)
WORKER_ID=python:rtx5080-1

# 시간 (초)
JOB_TIMEOUT_SEC=900
HEARTBEAT_SEC=30
STATUS_REPORT_SEC=30

# 브릿지 주소. Cloudflare Tunnel이 이 주소로 연결한다
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000
LOG_LEVEL=INFO
