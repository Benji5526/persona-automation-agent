    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Asset마다 caption Job 하나 (caption:{asset_id}). 테스트 이미지(visual_test, 17.8)는 캡션을 만들지 않는다.\nconst a = $json;\nif (a.content_jobs?.metadata?.purpose === 'visual_test') return { json: { skip: true, asset_id: a.id } };\nreturn { json: {\n  skip: false,\n  asset_id: a.id,\n  params: {\n    p_job_type: 'caption',\n    p_persona_id: a.persona_id,\n    p_content_job_id: a.content_job_id,\n    p_worker: 'n8n',\n    p_payload: { asset_id: a.id },\n    p_priority: null,\n    p_max_attempts: 3,\n    p_idempotency_key: `caption:${a.id}`\n  }\n} };"
      },
      "id": "pa004-caption-params",
      "name": "caption Job 준비",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.skip }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "pa004-if-caption",
