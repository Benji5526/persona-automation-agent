# n8n 서버 설정 (TECH_DESIGN 26.3). 이 파일을 .env로 복사해 채운다. .env는 git에 올리지 않는다.

# n8n 공개 도메인 (DNS A 레코드 → 이 서버)
N8N_HOST=n8n.example.com

# 버전을 고정한다. 업데이트는 월 1회, 백업 후 이 값을 올리고 docker compose up -d (15.9)
N8N_VERSION=

# Credential 암호화 키. 32자 이상 무작위 값. 한 번 정하면 바꾸지 않고 서버 밖에 오프라인으로 보관한다 (15.6)
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_ENCRYPTION_KEY=
