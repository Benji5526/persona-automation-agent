# =============================================================================
# Cloud GPU Pod 안의 Python Worker 환경 (TECH_DESIGN 56.5, 56.6)
#
# 이 파일에 **있는 것만** Pod에 넣는다. 아래는 Pod에 절대 두지 않는다 (config.py가 기동을 거부한다):
#   SUPABASE_SERVICE_ROLE_KEY · SUPABASE_SECRET_KEY · SUPABASE_JWT_SECRET · JWT_SIGNING_SECRET ·
#   WORKER_JWT_SECRET · SNS_ACCESS_TOKEN · SNS_REFRESH_TOKEN
# 통신은 Supabase로 나가는 HTTPS뿐이다. 인바운드 포트·Cloudflare Tunnel이 필요 없다.
#
# 이 값들은 소유자 PC에서 `python scripts/mint_worker_token.py --worker-id python:cloud-1 --target cloud
# --provider runpod --hours 8` 이 출력한 줄을 붙여 넣어 채운다. 서명 키는 소유자 PC에만 있다.
# =============================================================================

SUPABASE_URL=https://<project-ref>.supabase.co

# 인증: Worker JWT + 공개 anon 키 (service_role 키가 아니다). JWT 수명은 24시간 이하
WORKER_AUTH=worker_jwt
WORKER_JWT=
SUPABASE_ANON_KEY=

# 신원은 JWT 클레임이 정한다. 아래는 상태 보고용 표시값이다 (선점 권한은 DB가 자격으로 정한다)
WORKER_ID=python:cloud-1
WORKER_TARGET=cloud
WORKER_PROVIDER=runpod

# Worker Pull: 이 Pod가 DB에서 직접 cloud Job을 가져간다
PULL_JOBS=true
PULL_INTERVAL_SEC=5

# ComfyUI는 Pod 안에서만 (127.0.0.1). 밖으로 열지 않는다
COMFY_URL=http://127.0.0.1:8188

# 브릿지 API는 Pod 안 127.0.0.1에만 열린다. push는 worker_jwt 모드에서 꺼져 있어 쓰이지 않지만 설정 검증이 값을 요구한다.
# Pod 안에서 새로 만든 무작위 값을 쓴다: python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_TOKENS=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000

# n8n 콜백은 설정하지 않는다. 결과는 DB 상태로 이미 반영되고, 콜백 토큰을 Pod에 둘 이유가 없다.
# N8N_CALLBACK_URL=
# N8N_CALLBACK_TOKEN=

JOB_TIMEOUT_SEC=900
HEARTBEAT_SEC=30
STATUS_REPORT_SEC=30
LOG_LEVEL=INFO
